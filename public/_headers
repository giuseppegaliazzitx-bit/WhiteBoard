# Cloudflare Pages reads this file and applies these headers to every response.
/*
  # The board holds no secrets worth stealing, but it does render text that any
  # visitor can write, so the XSS surface is worth closing off properly.
  # 'unsafe-inline' is present for styles only: element.style.setProperty is not
  # actually governed by CSP, but inline style attributes in the markup are.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.supabase.in wss://*.supabase.in; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  X-Frame-Options: DENY

# Hashed asset filenames change whenever the content does, so they can be
# cached hard. index.html must not be, or a deploy would not reach anyone.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache
