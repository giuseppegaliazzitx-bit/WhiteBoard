# Copy this file to `.env` and fill in your Supabase project values.
#   cp .env.example .env
#
# Find both under: Supabase dashboard -> Project Settings -> API
#
# IMPORTANT: use the *anon / public* key, never the service_role key.
# The anon key is compiled into the built page and is visible to anyone
# who loads the site. That is expected for this design (see SECURITY.md),
# but it means the key must be one that RLS policies actually constrain.
#
# Leave these blank to run the board entirely in browser localStorage
# (no account needed, no sharing between people). Useful for local dev.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Which board this deployment shows. Reserved for a future board switcher;
# a single deployment only ever reads and writes rows with this value.
VITE_BOARD_ID=main
